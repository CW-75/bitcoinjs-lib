{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@decentralfi/*": [
        "packages/*"
      ]
    },
    "outDir": "lib",
    "module": "ESNext",
    "target": "ES6",
    "lib": [
      "es6",
      "dom",
      "es2016",
      "es2017",
      "ES2020"
    ],
    "allowUmdGlobalAccess": true,
    "importHelpers": true,
    "declaration": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "examples",
    "node_modules",
    "test",
    "lib"
  ]
}